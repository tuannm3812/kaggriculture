.venv/
__pycache__/
*.pyc
.pytest_cache/

# Raw competition/game files and generated artifacts
replays/**/*.json
!replays/.gitkeep
!replays/public/manifest.json
replays/public/raw/
replays/public/*.jsonl
scripts/public_artifacts.json
scratch/
*.tar.gz
kaggriculture.zip
build/

# Staged notebook copy for scripts/push_kaggle_kernel.sh (source of truth
# lives in notebooks/00_platform_smoke_test.ipynb; the kernel dir needs its
# own copy alongside kernel-metadata.json)
notebooks/kernels/*/*.ipynb

# Regenerated by scripts/build_agent_submission_notebook.py from build/<agent>/main.py
notebooks/03_*_submission.ipynb

# Training artifacts (large, regenerable, not for git)
checkpoints/
*.safetensors
*.pt

# Git worktrees (local isolation)
.worktrees/
